# admin-server-go 的 nginx 反代样例（占位值；实际域名 / 证书路径由部署环境注入，仓库不写真实值）。
# 只把 /api/admin/* 与公开分享 /s/* 反代到回环 19265；公开分享路径绝不可加鉴权。

server {
    listen 443 ssl;
    server_name example.com;

    # ssl_certificate     /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    # 管理端 API：默认上限 100m
    location /api/admin/ {
        proxy_pass http://127.0.0.1:19265;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;

        # 系统 SSE 需关闭缓冲
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # 文件区上传：单独放宽到 512m（nginx 先于应用层拒绝，超限返回 HTML 而非 JSON）
    location /api/admin/files/upload {
        proxy_pass http://127.0.0.1:19265;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 512m;
    }

    # 公开分享链接：免鉴权，token 即凭据
    location /s/ {
        proxy_pass http://127.0.0.1:19265;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # 公开应用中心
    location /api/public/ {
        proxy_pass http://127.0.0.1:19265;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
