; admin-server-go 的 systemd 单元样例（按需复制到 /etc/systemd/system/，仓库不代为安装）。
; 只监听回环，对外由 nginx 反代；运行时数据目录用 ADMIN_REPO_ROOT 指向实际安装目录。
[Unit]
Description=admin-server-go（个人网站 Admin 后端）
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
WorkingDirectory=/opt/admin-server-go
ExecStart=/opt/admin-server-go/admin-server-go
Restart=always
RestartSec=3

; 只监听回环；端口在 19xxx 段，避免与线上 3100 冲突
Environment=HOST=127.0.0.1
Environment=PORT=19265
Environment=ADMIN_REPO_ROOT=/opt/admin-server-go

; 可选：认证模式 / 认证中心 / 数据库
; Environment=AUTH_MODE=builtin
; Environment=AUTH_CENTER_BASE_URL=http://127.0.0.1:3200
; Environment=AUTH_CENTER_INTERNAL_TOKEN_FILE=/opt/admin-server-go/secrets/internal-token
; Environment=DB_DRIVER=sqlite
; Environment=DB_DRIVER=mysql
; Environment=DB_HOST=127.0.0.1
; Environment=DB_PORT=3306
; Environment=DB_USER=admin
; Environment=DB_METRICS_NAME=admin_metrics
; Environment=DB_NOTIFICATIONS_NAME=admin_notifications

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
